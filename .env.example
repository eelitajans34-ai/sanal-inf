# Veritabanı: yerelde SQLite dosyası. Canlıda Turso (libsql://...) + DATABASE_AUTH_TOKEN
DATABASE_URL="file:./data.db"
DATABASE_AUTH_TOKEN=""

# Not: API anahtarları panelde Kurulum sayfasından da girilebilir (önceliklidir).

# Panel parolası (canlıda ZORUNLU)
ADMIN_PASSWORD=""

# Metin üretimi: Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Görsel üretimi: Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
REPLICATE_IMAGE_MODEL="black-forest-labs/flux-1.1-pro"
# Referans fotoğrafla yüzü koruyarak üretim
REPLICATE_KONTEXT_MODEL="black-forest-labs/flux-kontext-pro"
# Karaktere özel LoRA eğitimi
REPLICATE_TRAINER="ostris/flux-dev-lora-trainer"

# Ses (MiniMax Speech) ve video motorları — varsayılanlar yeterli
REPLICATE_TTS_MODEL="minimax/speech-2.6-hd"
VIDEO_OMNIHUMAN_MODEL="bytedance/omni-human-1.5"
VIDEO_KLING_AVATAR_MODEL="kwaivgi/kling-avatar-v2"
VIDEO_KLING_MODEL="kwaivgi/kling-v2.5-turbo-pro"
VIDEO_SEEDANCE_MODEL="bytedance/seedance-1-pro"
VIDEO_HAILUO_MODEL="minimax/hailuo-2.3"
# İsteğe bağlı: sistemdeki ffmpeg (boşsa ffmpeg-static paketi kullanılır)
FFMPEG_PATH=""

# Otomatik paylaşım: Instagram Graph API (Business/Creator hesap)
INSTAGRAM_ACCESS_TOKEN=""
# Instagram görseli herkese açık URL'den çeker: sitenin canlı adresi
PUBLIC_BASE_URL=""

# /api/cron/tick uç noktasını korur (dış zamanlayıcı kullanılacaksa)
CRON_SECRET=""

# Arka plan işçisi: uygulama açıkken her dakika çalışır (kapatmak için WORKER=off)
WORKER=""
WORKER_INTERVAL_MS="60000"

# Üretilen görsellerin saklandığı klasör
MEDIA_DIR=".data/media"
